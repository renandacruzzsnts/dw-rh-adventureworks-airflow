AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_LOAD_EXAMPLES=false
AIRFLOW_LOGGING_LEVEL=WARNING
AIRFLOW_PARALLELISM=4
AIRFLOW_MAX_ACTIVE_TASKS_PER_DAG=2

# Postgres (metadados do Airflow + Data Warehouse)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow_local_password
POSTGRES_DB=airflow

# SQL Server (origem AdventureWorks). Senha forte, sem @ : / (vai dentro da URL de conexao)
MSSQL_SA_PASSWORD=SqlServer2025Aw

# Generate with: docker run --rm apache/airflow:3.3.1 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=replace_with_a_fernet_key
# Generate with: docker run --rm apache/airflow:3.3.1 python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW_API_SECRET_KEY=replace_with_a_long_random_secret
AIRFLOW_JWT_SECRET=replace_with_a_long_random_jwt_secret

_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin_local_password
_PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-postgres apache-airflow-providers-microsoft-mssql apache-airflow-providers-fab

# Conexoes do Airflow (mantenha usuario/senha iguais aos de cima)
AIRFLOW_CONN_AW_SOURCE=mssql://sa:SqlServer2025Aw@sqlserver:1433/AdventureWorks2025
AIRFLOW_CONN_PG_STAGE=postgresql://airflow:airflow_local_password@postgres:5432/dw
AIRFLOW_CONN_PG_DW=postgresql://airflow:airflow_local_password@postgres:5432/dw
